    {
        "id": "6b70bb3a63cca9cb",
        "type": "function",
        "z": "14eb7d011d2de889",
        "name": "Combine Values into Array",
        "func": "function floatToRegisters(float) {\n    var buffer = new ArrayBuffer(4);\n    var view = new DataView(buffer);\n    view.setFloat32(0, float, false); // false for big-endian\n    return [view.getUint16(0, false), view.getUint16(2, false)];\n}\n\nvar obtainV = global.get('voltage1');\nvar obtainV2 = global.get(\"voltage2\");\nvar obtainV3 = global.get(\"voltage3\");\nvar obtainI = global.get(\"current1\");\nvar obtainI2 = global.get(\"current2\");\nvar obtainI3 = global.get(\"current3\");\n\nconst modbus = [\n    ...floatToRegisters(obtainV),\n    ...floatToRegisters(obtainV2),\n    ...floatToRegisters(obtainV3),\n    ...floatToRegisters(obtainI),\n    ...floatToRegisters(obtainI2),\n    ...floatToRegisters(obtainI3)\n];\n\nmsg.payload = modbus;\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 540,
